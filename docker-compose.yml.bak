version: '2.0'

services:

  admindb:
    restart: always
    image: adminer
    depends_on:
    - database
    ports:
    - "8003:8080"

  database:
    restart: always
    image: postgres
    volumes:
    - ./database:/var/lib/postgresql/data
    environment:
    - POSTGRES_PASSWORD=gu3bm3t
    - POSTGRES_USER=webmet
    - POSTGRES_DB=webmet

  webmet:
    restart: always
    image: djwebmet:latest
    depends_on:
    - database
    ports:
    - "8002:80"
    volumes:
    - .:/app/website
    - ~/new_radars_pngs:/import_images
