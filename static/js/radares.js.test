function check_polarimetrics_var(){
    if ($('#layer-radar-div input:checkbox:checked').length >= 4){
        //Materialize.toast('Se puede selecionar hasta 4 variables Polarimetricas ', 3000);
        $('#layer-radar-div input:checkbox:not(":checked")').each(function (i) {
            $(this).prop('disabled', true);
            //$(this).children().find('input[type=range]').prop('disabled', true);
            //$(this).next('input[type=range]').prop('disabled', true);
        });
    }else {
        $('#layer-radar-div input:checkbox:not(":checked")').each(function (i) {
            $(this).prop('disabled', false);
            //$(this).children().find('input[type=range]').prop('disabled', false);
            //console.log($(this).parent());
        });
    }
    polarimetric_selected = []
    $('#layer-radar-div input:checkbox:checked').each(function (i) {
        polarimetric_selected.push($(this).data('layer'));
        //$(this).children().find('input[type=range]').prop('disabled', true);
        //$(this).next('input[type=range]').prop('disabled', true);
    });
    //console.log(polarimetric_selected);

}


/**
* @params None
* @description
*  Search off radars of api application .
* @Author GRC - Kaajavi
*/

function search_wrf(){
    for (var wrf_idx=0; wrf_idx<wrf_prod.length; wrf_idx++){

        wrf[wrf_prod[wrf_idx]] = new L.imageOverlay(null,
                                                    [ [-27.6, -56.4],[-37.3, -69]],
                                                    {
            opacity: ret_wrf_opacity(wrf_prod[wrf_idx]),
            zIndex: parseInt($('.sortable[data-layer="wrf"]').data('layer-z')),
        }).addTo(map);
    }
}

function search_radars(){
    search_wrf();
    $.ajax({
        url: "/api_radares/radares/?format=json"
    }).then(function(data) {
        radares = {};
        $.each(data, function(i, radar) {
            var southWest = L.latLng(radar.point2_lat, radar.point2_long);
            var northEast = L.latLng(radar.point1_lat, radar.point1_long);
            console.log(radar.point2_lat);
            var bounds = L.latLngBounds(southWest, northEast);
            
            // TESTING
            // if ($('.layer_selection[data-layer="'+radar.title+'"]').is(':checked')==false){
            //     return 0;
            // }
            
            
            radares[radar.code]={}
            radares[radar.code]['title'] = radar.title;
            radares[radar.code]['lat'] = parseFloat(radar.center_lat);
            radares[radar.code]['long'] = parseFloat(radar.center_long);
            radares[radar.code]['cobertura'] = new L.circle([parseFloat(radar.center_lat),parseFloat(radar.center_long)],
                                                            {radius: 1000 * parseInt(radar.img_radio),
                                                             stroke: false,
                                                             fillOpacity:$('.layer_selection[data-layer="radar_radios"]').is(':checked')? parseInt($('.layer_input[data-layer="radar_radios"]').val())/100:0,
                                                             fill: true,
                                                             fillColor: 'blue'
                                                            }).addTo(map);
            console.log(radares[radar.code]['cobertura'].getBounds());
            radares[radar.code]['extent'] = bounds;
            radares[radar.code]['counter'] = 0;
            radares[radar.code]['layer_group'] = new L.layerGroup([radares[radar.code]['cobertura']]).addTo(map);

            for (j=0; j<polarimetrics_vars.length; j++){
                radares[radar.code]['layer_'+polarimetrics_vars[j]] = new L.imageOverlay('/static/images/vacio.png',
                                                                                         radares[radar.code]['extent'],
                                                                                         {
                    opacity: (polarimetric_selected.indexOf(polarimetrics_vars[j])>=0)?parseInt($('.layer_input[data-layer="'+polarimetrics_vars[j]+'"]').val())/100:0,
                    zIndex: parseInt($('.sortable[data-layer="'+polarimetrics_vars[j]+'"]').data('layer-z')),
                }).addTo(map);

                radares[radar.code]['layer_group'].addLayer(radares[radar.code]['layer_'+polarimetrics_vars[j]])

            }
            //            layerscontrol.push({['Radar ' +radar.code]: radares[radar.code]['layer_group']});
            layer_control.addOverlay(radares[radar.code]['layer_group'],radar.code + ' - ' + radar.title);

        });
        layer_control.addTo(map);
        search_images();
    });
};

function change_date(){
    //delete sources;
    $('#circle_search').removeClass('hide');
    $('#btn_search').addClass('hide');
    console.log('Cambiando fecha');
    if (automatic!=null){
        clearInterval(automatic);
        automatic = null;
        $('#velocidad').fadeOut(500);
        $('#click_play_arrow').html('<i class="material-icons">play_arrow</i>');
    }
    clear_layers();
    //    sources = null;
    //    sources = {};

